<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>zmień twój PLL / Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
<div class="container mt-5">
  <a href="/admin" class="btn btn-outline-light position-absolute top-1 end-1">Strona Admina</a>
  <h2 class="mb-4 text-center">Edytuj PLL - <%= pll.name %></h2>
<form action="/admin/edit-pll" method="POST">
  <input type="hidden" name="name" value="<%= pll.name %>">
  <input type="hidden" name="user_id" value="<%= pll.user_id %>">

  <div class="mb-3">
    <label for="algorithm" class="form-label">Algorytm</label>
    <input type="text" class="form-control" id="algorithm" name="algorithm" value="<%= pll.algorithm %>" required>
  </div>

  <div class="mb-3">
    <label for="best_time" class="form-label">Najlepszy czas (s)</label>
    <input type="number" step="0.01" class="form-control" id="best_time" name="best_time" value="<%= pll.best_time %>" required>
  </div>

  <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
  <a href="/admin" class="btn btn-secondary">Anuluj</a>
</form>
</div>
</body>
</html>