<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Dodaj / zmień twój PLL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

<div class="container mt-5">
  <a href="/" class="btn btn-outline-light position-absolute top-1 end-1">Strona główna</a>
  <h1 class="mb-4 text-center">Dodaj lub zmień twój PLL</h1>
  <% if (error === "notLoggedIn") { %>
  <div class="alert alert-danger text-center">
    Nie jesteś zalogowany. Aby dodać lub edytować PLL <a href="/login">zaloguj się</a> lub <a href="/register">zarejestruj się</a>.
  </div>
<% } else { %>
  <form action="/add-change-yourpll" method="POST" class="bg-secondary p-4 rounded">
  <div class="mb-3">
    <label for="name" class="form-label text-light">Nazwa PLL</label>
    <input type="text" class="form-control" id="name" name="name" value="<%= pll ? pll.name : '' %>" required>
  </div>
  <div class="mb-3">
    <label for="algorithm" class="form-label text-light">Algorytm</label>
    <input type="text" class="form-control" id="algorithm" name="algorithm" value="<%= pll ? pll.algorithm : '' %>" required>
  </div>
  <div class="mb-3">
    <label for="best_time" class="form-label text-light">Najlepszy czas (s)</label>
    <input type="number" step="0.01" class="form-control" id="best_time" name="best_time" value="<%= pll ? pll.best_time : '' %>" required>
  </div>
  <button type="submit" class="btn btn-primary w-100">Zapisz / Zaktualizuj</button>
</form>
<% } %>
</div>
</body>
</html>
