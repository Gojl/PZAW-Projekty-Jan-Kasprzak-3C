<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>3x3 PLL Database</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
<div class="container text-center mt-5">
    <h1 class="mb-4">3×3 PLL Database</h1>

    <% if (session && session.user_id) { %>
        <p class="text-success">Jesteś zalogowany</p>
        <form action="/logout" method="POST">
            <button class="btn btn-danger mb-3">Wyloguj</button>
        </form>
    <% } else { %>
        <a href="/login" class="d-block mb-2 link-info">Zaloguj się</a>
        <a href="/register" class="d-block mb-3 link-light">Zarejestruj się</a>
    <% } %>

    <a href="myplls" class="d-block mb-2 link-primary">Moje algorytmy i czasy</a>
    <a href="yourplls" class="d-block mb-2 link-success">Algorytmy i czasy użytkownika</a>
    <a href="add-change" class="d-block link-warning">Dodaj lub zmień algorytm lub czas</a>
    <% if (isAdmin) { %>
  <a href="/admin" class="d-block mb-2 link-danger fw-bold">
    Panel administratora
  </a>
<% } %>
</div>
</body>
</html>
