<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Panel Admina - Wszystkie PLL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
  <div class="container mt-5">
  <div class="container mt-5">
    <a href="/" class="btn btn-outline-light position-absolute top-1 end-1">Strona główna</a>
    <h1 class="mb-4 text-center">Panel Admina - Wszystkie PLL</h1>

    <% if (!pll || pll.length === 0) { %>
      <div class="alert alert-danger text-center fw-bold">
        Brak PLL w bazie danych.
      </div>
    <% } else { %>
      <table class="table table-dark table-striped table-hover">
        <thead>
          <tr>
            <th>Użytkownik ID</th>
            <th>PLL</th>
            <th>Algorytm</th>
            <th>Najlepszy czas (s)</th>
            <th>Akcje</th>
          </tr>
        </thead>
        <tbody>
          <% pll.forEach(p => { %>
            <tr>
              <td><%= p.user_id %></td>
              <td><strong><%= p.name %></strong></td>
              <td><code class="text-light"><%= p.algorithm %></code></td>
              <td><%= p.best_time %></td>
              <td class="d-flex gap-2">

                <form action="/admin/delete-pll" method="POST">
                  <input type="hidden" name="name" value="<%= p.name %>">
                  <input type="hidden" name="user_id" value="<%= p.user_id %>">
                  <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
                </form>
                <form action="/admin/admin-edit" method="GET" style="display:inline">
                    <input type="hidden" name="name" value="<%= p.name %>">
                    <input type="hidden" name="user_id" value="<%= p.user_id %>">
                    <button type="submit" class="btn btn-sm btn-warning">Edytuj</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>