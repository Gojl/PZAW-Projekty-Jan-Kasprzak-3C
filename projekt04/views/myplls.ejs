<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Moje PLL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

<div class="container mt-5">
  <h1 class="mb-4 text-center">Moje PLL</h1>
  <table class="table table-dark table-striped table-hover">
    <thead>
      <tr>
        <th>PLL</th>
        <th>Algorytm</th>
        <th>Najlepszy czas (s)</th>
      </tr>
    </thead>
    <tbody>
      <% pll.forEach(p => { %>
        <tr>
          <td><strong><%= p.name %></strong></td>
          <td><code class="text-light"><%= p.algorithm %></code></td>
          <td><%= p.best_time %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
